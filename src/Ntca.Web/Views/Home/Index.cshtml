@model (List<Ntca.Core.ShopEvent> Shows, List<Ntca.Core.Post> Posts)
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Protecting, Promoting and Powering the Hobby. A national community of collectors, shops and events uniting the trading card hobby.";
    var featured = (List<Ntca.Core.Shop>)ViewBag.Featured;
    var rotation = (List<Ntca.Core.Shop>)ViewBag.Rotation;
    var discover = featured.Count > 0 ? featured.Take(4).ToList() : rotation.Take(4).ToList();
}
<section class="home-hero">
    <div class="ntca-container home-hero-inner">
        <div>
            <p class="eyebrow">Built by collectors, for collectors.</p>
            <h1>Protecting, Promoting and Powering the Hobby.</h1>
            <p class="lede">A national community of collectors, shops and events uniting the trading card hobby.</p>
            <form class="hero-search" method="get" action="/shops" role="search" data-testid="home-search">
                <label>
                    Search type
                    <select name="what" aria-label="Find shops or events">
                        <option value="shops" selected>Find shops &amp; events</option>
                        <option value="events">Find events</option>
                    </select>
                </label>
                <label>
                    Location
                    <input name="location" type="search" placeholder="City or ZIP code" autocomplete="postal-code" />
                </label>
                <button class="ntca-primary-action" type="submit">Explore</button>
            </form>
        </div>
    </div>
</section>
<nav class="cat-nav" aria-label="Shop categories">
    <div class="cat-nav-inner">
        <a class="on" href="/shops">All cards</a>
        <a href="/shops?specialty=SPORTS">Sports cards</a>
        <a href="/shops?specialty=POKEMON">Pokémon</a>
        <a href="/shops?specialty=MAGIC">Magic: The Gathering</a>
        <a href="/shops?specialty=OTHER">Other TCGs</a>
    </div>
</nav>
<section class="home-discover">
    <div class="ntca-container">
        <div class="home-discover-head">
            <h2>Discover your next favorite shop</h2>
        </div>
        <div class="home-split">
            <div>
                @if (discover.Count == 0)
                {
                    <p class="lede">Shop listings will appear here from the NTCA directory.</p>
                }
                else
                {
                    <div class="home-shop-grid">
                    @foreach (var s in discover)
                    {
                        @await Html.PartialAsync("~/Views/Shops/_ShopCard.cshtml", s)
                    }
                    </div>
                }
            </div>
            <aside>
                <a class="history-card" href="/new-to-trading-cards">
                    <img src="~/img/history-hobby.jpeg" alt="Vintage trading cards" width="640" height="400" />
                    <div>
                        <p class="eyebrow">150 years of the hobby</p>
                        <h2>From Advertising Cards to a Global Hobby</h2>
                        <p class="meta">Explore the people, innovation and cultural moments that shaped 150 years of collecting.</p>
                        <span class="btn ghost">Explore the history</span>
                    </div>
                </a>
            </aside>
        </div>
    </div>
</section>
<section class="home-events" id="events">
    <div class="ntca-container">
        <h2>Meet. Trade. Collect.</h2>
        <p class="lede">Find upcoming shows and community events near you.</p>
        <div class="event-list">
        @foreach (var e in Model.Shows.Take(4))
        {
            @await Html.PartialAsync("_EventCard", e)
        }
        </div>
        @if (Model.Shows.Count == 0)
        {
            <p class="meta">No upcoming events listed.</p>
        }
        else
        {
            <p><a href="/calendar">View all events</a> · <a href="/events">Association events</a></p>
        }
        @if (ViewBag.Kickoff is Ntca.Core.AssociationEvent kickoff)
        {
            <aside class="home-kickoff">
                <p class="eyebrow">Halloween kickoff</p>
                <h3>@kickoff.Title</h3>
                <p>@kickoff.Description</p>
                <p><a class="btn ghost" href="/events#@kickoff.Slug">Event details</a></p>
            </aside>
        }
    </div>
</section>
@if (ViewBag.Gallery is List<Ntca.Core.GalleryItem> homeGallery && homeGallery.Count > 0 && ViewBag.Files is IFileStorage homeFiles)
{
<section class="home-events">
    <div class="ntca-container">
        <h2>The hobby, in pictures</h2>
        <p class="lede">From the NTCA gallery — shops, show floors, and the people who collect.</p>
        <div class="gallery-grid gallery-grid-sm">
        @foreach (var g in homeGallery)
        {
            <a href="/gallery#@g.Slug">
                <img src="@homeFiles.PublicUrl(g.LegacyPath)" alt="@(g.AltText ?? g.Caption)" width="400" height="300" />
                <span>@g.Caption</span>
            </a>
        }
        </div>
        <p><a class="btn ghost" href="/gallery">Open the gallery</a> · <a href="/about">Meet the people</a></p>
    </div>
</section>
}
@if (Model.Posts.Count > 0)
{
<section class="home-events">
    <div class="ntca-container">
        <h2>From the desk</h2>
        <div class="grid">
        @foreach (var p in Model.Posts)
        {
            <a class="card" href="/news/@p.Slug">
                <h3>@p.Title</h3>
                <p class="meta">@p.PublishedAt?.ToString("MMM d, yyyy") · @p.AuthorName</p>
                <p>@p.Excerpt</p>
            </a>
        }
        </div>
    </div>
</section>
}
@section Scripts {
    <script>
        document.querySelector(".hero-search")?.addEventListener("submit", function (e) {
            var what = this.querySelector("[name=what]");
            if (what && what.value === "events") {
                e.preventDefault();
                var loc = this.querySelector("[name=location]")?.value || "";
                var url = "/calendar";
                if (loc) url += "?q=" + encodeURIComponent(loc);
                window.location = url;
            }
        });
    </script>
}
