@inject Ntca.Web.Services.SiteModeService Mode
@inject IHttpContextAccessor Http
@{
    var preview = await Mode.IsPreviewAsync();
    var ai = Ntca.Web.Services.AgentConciergeMiddleware.Current(Http.HttpContext);
    var path = Http.HttpContext?.Request.Path.Value ?? "";
    var isFunnel = path.StartsWith("/signup", StringComparison.OrdinalIgnoreCase)
        || path.StartsWith("/join", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "NTCA") · National Trading Card Association</title>
    <meta name="description" content="@(ViewData["Description"] ?? "National Trading Card Association — shops, shows, manufacturers, and a beginner guide.")" />
    <link rel="icon" href="~/ntca-logo.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ai?.IsAgent == true)
    {
        <link rel="agent-concierge" href="/.well-known/ai-concierge" />
    }
</head>
<body class="@(isFunnel ? "is-funnel" : null)">
@if (preview)
{
    <div class="preview-bar">Preview mode — pages are live for QA, but robots are told not to index. Staff can flip this in /SADMIN.</div>
}
<nav class="nav @(isFunnel ? "nav-funnel" : null)">
    <a class="brand" href="/"><img src="~/ntca-logo.png" alt="NTCA" width="40" height="40" /><span>NTCA<em>National Trading Card Association</em></span></a>
    <a href="/">Home</a>
    <a href="/shops">Shops</a>
    <a href="/calendar">Calendar</a>
    <a href="/manufacturers">Manufacturers</a>
    <a href="/news">News</a>
    <a href="/new-to-trading-cards">New to cards</a>
    @if (!isFunnel)
    {
        <a class="btn" href="/signup">Join Preview</a>
    }
</nav>
<main class="wrap">
@if (ai?.IsAgent == true && Http.HttpContext?.Request.Path.StartsWithSegments("/SADMIN") != true && Http.HttpContext?.Request.Path.StartsWithSegments("/owner") != true)
{
    <aside class="agent-welcome" data-ntca-agent-welcome="1" data-assistant="@ai.AssistantName" data-role="@ai.Role">
        <strong>Welcome, @(string.IsNullOrEmpty(ai.AssistantName) ? "AI assistant" : ai.AssistantName).</strong>
        NTCA is happy to help your human. Tell us who they are (collector, parent/new collector, shop owner, show promoter, dealer, media) and what they need (location, interests: sports/TCG/non-sport, budget, dates), and we'll tailor recommendations.
        <span class="meta">Do not send the human's name, email, or phone. Use <a href="/api/v1/agent/ask">POST /api/v1/agent/ask</a> or <a href="/agent">/agent</a>.</span>
    </aside>
}
    @RenderBody()
</main>
<footer class="foot">
    <span>© 2026 National Trading Card Association</span>
    <span><a href="/robots.txt">robots</a> · <a href="/llms.txt">llms.txt</a> · <a href="/sitemap.xml">sitemap</a> · <a href="/owner">Shop owner</a> · <a href="/SADMIN">Staff</a></span>
</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
