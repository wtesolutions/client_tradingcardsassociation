@model List<Ntca.Core.Shop>
@{
    ViewData["Title"] = (string)ViewBag.StateName + " shops";
}
<nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> / <a href="/shops">Shops</a> / <span>@ViewBag.StateName</span>
</nav>
<p class="kicker">Directory</p>
<h1>Hobby shops in @ViewBag.StateName</h1>
<p class="lede">@Model.Count active listings in @ViewBag.State.</p>
<div class="grid">
@foreach (var s in Model)
{
    <a class="card" href="@Ntca.Web.Services.ShopCopy.Loc(s)">
        <h3>@s.Name</h3>
        <p class="meta">@s.City, @s.StateCode @(s.IsDestinationShop ? "· Destination" : "")</p>
    </a>
}
</div>
<p><a href="/shops">← All shops</a></p>
