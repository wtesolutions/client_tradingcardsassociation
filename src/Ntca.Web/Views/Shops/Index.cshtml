@model List<Ntca.Core.Shop>
@{
    ViewData["Title"] = "Shop directory";
}
<p class="kicker">Directory</p>
<h1>Hobby shops</h1>
<p class="lede">@Model.Count listings from the seeded NTCA directory. Search by name, city, or ZIP. Near me uses your browser location (opt-in).</p>
@await Html.PartialAsync("_DirectoryBar")
<div class="shop-card-list">
@foreach (var s in Model)
{
    @await Html.PartialAsync("_ShopCard", s)
}
</div>
@section Scripts {
    <script src="~/js/directory.js" asp-append-version="true"></script>
}
