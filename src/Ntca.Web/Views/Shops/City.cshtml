@model List<Ntca.Core.Shop>
@{
    ViewData["Title"] = $"{ViewBag.City}, {ViewBag.State} shops";
}
<nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> /
    <a href="/shops">Shops</a> /
    <a href="/shops/@(((string)ViewBag.State).ToLowerInvariant())">@ViewBag.StateName</a> /
    <span>@ViewBag.City</span>
</nav>
<p class="kicker">Directory</p>
<h1>Hobby shops in @ViewBag.City, @ViewBag.State</h1>
<p class="lede">@Model.Count active listing@(Model.Count == 1 ? "" : "s").</p>
<div class="grid">
@foreach (var s in Model)
{
    <a class="card" href="@Ntca.Web.Services.ShopCopy.Loc(s)">
        <h3>@s.Name</h3>
        <p class="meta">@s.City, @s.StateCode @(s.IsDestinationShop ? "· Destination" : "")</p>
    </a>
}
</div>
<p><a href="/shops/@(((string)ViewBag.State).ToLowerInvariant())">← @ViewBag.StateName shops</a></p>
