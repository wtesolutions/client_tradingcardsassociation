@model Ntca.Web.Controllers.ShopDetailVm
@{
    var s = Model.Shop;
    ViewData["Title"] = s.Name;
}
<nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> /
    <a href="/shops">Shops</a> /
    <a href="/shops/@s.StateCode.ToLowerInvariant()">@Ntca.Web.Services.ShopCopy.StateName(s.StateCode)</a> /
    <a href="/shops/@s.StateCode.ToLowerInvariant()/@Ntca.Web.Services.ShopCopy.CitySlug(s.City)">@s.City</a> /
    <span>@s.Name</span>
</nav>
<header class="shop-hero">
    <div class="shop-card-thumb @(Ntca.Web.Services.ShopCopy.MapThumbUrl(s) is null ? "ph" : "")">
        @if (Ntca.Web.Services.ShopCopy.MapThumbUrl(s) is string thumb)
        {
            <img src="@thumb" alt="" width="140" height="140" data-fallback="@Ntca.Web.Services.ShopCopy.MapTileUrl(s)"
                 onerror="if(this.dataset.fallback&amp;&amp;this.src!==this.dataset.fallback)this.src=this.dataset.fallback;" />
            <span class="shop-card-pin" aria-hidden="true"></span>
        }
        else
        {
            <span class="shop-card-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" width="44" height="44" fill="none"><rect x="10" y="8" width="28" height="32" rx="4" stroke="currentColor" stroke-width="2"/><path d="M16 18h16M16 24h12M16 30h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </span>
        }
    </div>
    <div>
        <p class="shop-card-where">
            <svg class="pin" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
            @s.City, @s.StateCode
            @if (s.IsDestinationShop) { <span class="pill dest">Destination</span> }
            @if (!string.IsNullOrEmpty(Model.TierName)) { <span class="pill">@Model.TierName</span> }
        </p>
        <h1 class="shop-name">@s.Name</h1>
        <p class="shop-hero-actions">
            @if (!string.IsNullOrEmpty(s.Phone))
            {
                <a class="btn ghost call" href="/t/phone?shop=@s.ShopId">Call</a>
            }
            @if (Ntca.Web.Services.ShopCopy.HasMappableAddress(s))
            {
                <a class="btn ghost" href="/t/directions?shop=@s.ShopId" rel="noopener">Directions</a>
            }
            @if (!string.IsNullOrEmpty(s.WebsiteUrl))
            {
                <a class="btn" href="/t/website?shop=@s.ShopId" rel="noopener">Website</a>
            }
        </p>
    </div>
</header>
<p class="shop-ai-summary ai-summary">@Model.AiSummary</p>
@if (!string.IsNullOrEmpty(s.Description))
{
    <p class="lede">@s.Description</p>
}
<div class="card">
    @if (!string.IsNullOrEmpty(s.AddressLine1)) { <p>@s.AddressLine1</p> }
    <p>@s.City, @s.StateCode @s.PostalCode</p>
    @if (!string.IsNullOrEmpty(s.Phone))
    {
        <p><a href="/t/phone?shop=@s.ShopId">@s.Phone</a></p>
    }
    @if (!string.IsNullOrEmpty(s.WebsiteUrl))
    {
        <p><a href="/t/website?shop=@s.ShopId" rel="noopener">Website</a></p>
    }
    @if (Ntca.Web.Services.ShopCopy.HasMappableAddress(s))
    {
        <p><a href="/t/directions?shop=@s.ShopId" rel="noopener">Directions</a></p>
    }
    @if (!string.IsNullOrEmpty(s.FacebookUrl))
    {
        <p><a href="/t/social?shop=@s.ShopId&amp;net=facebook" rel="noopener">Facebook</a></p>
    }
    @if (!string.IsNullOrEmpty(s.InstagramHandle))
    {
        <p><a href="/t/social?shop=@s.ShopId&amp;net=instagram" rel="noopener">Instagram</a></p>
    }
    @if (!string.IsNullOrEmpty(s.PublicEmail))
    {
        <p><a href="mailto:@s.PublicEmail">@s.PublicEmail</a></p>
    }
    <p class="meta">Claim: @s.ClaimStatus · Listing: @s.ListingStatus</p>
</div>
@if (Model.Hours.Any(h => !h.IsClosed && h.OpensAt is not null))
{
    <h2>Hours</h2>
    <ul>
    @foreach (var h in Model.Hours.Where(h => !h.IsClosed && h.OpensAt is not null && h.ClosesAt is not null))
    {
        <li>@Ntca.Web.Services.ShopCopy.DayName(h.DayOfWeek) @h.OpensAt?.ToString("HH:mm")–@h.ClosesAt?.ToString("HH:mm")</li>
    }
    </ul>
}
@if (Model.Events.Count > 0)
{
    <h2>Upcoming events</h2>
    <ul>
    @foreach (var e in Model.Events)
    {
        <li>@e.StartsAt.ToString("MMM d, yyyy") — @e.Title</li>
    }
    </ul>
}
<p class="meta"><a href="@Model.MarkdownUrl">Plain-text version</a> for AI crawlers</p>
<p><a href="/shops/@s.StateCode.ToLowerInvariant()">@Ntca.Web.Services.ShopCopy.StateName(s.StateCode) shops</a> · <a href="/shops">All shops</a></p>
@section Scripts {
@Html.Raw("<script type=\"application/ld+json\">\n")
@Html.Raw(Model.JsonLd)
@Html.Raw("\n</script>")
}
