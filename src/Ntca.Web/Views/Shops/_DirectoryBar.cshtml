@using Ntca.Web.Services
@{
    var query = ViewBag.Query as DirectoryQuery ?? ShopDirectory.Parse(
        ViewBag.Q as string, ViewBag.Location as string, ViewBag.Zip as string,
        ViewBag.Specialty as string, ViewBag.Sort as string,
        ViewBag.OpenNow is true ? "1" : null,
        ViewBag.RadiusMiles?.ToString(),
        ViewBag.OriginLat as double?, ViewBag.OriginLng as double?,
        ViewBag.Page as int?);
    var sort = (string)(ViewBag.Sort ?? ShopDirectory.ResolveSort(query, ViewBag.HasOrigin is true));
    var hasLocation = query.Location.Length > 0;
}
<form class="dir-search" method="get" action="/shops" id="dir-bar" role="search" data-testid="shops-search">
    <div class="field">
        <label class="visually-hidden" for="dir-q">Shop name or specialty</label>
        <span class="field-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </span>
        <input id="dir-q" name="q" value="@query.Q" placeholder="Shop name or specialty" data-testid="shops-q" />
    </div>
    <div class="field">
        <label class="visually-hidden" for="dir-location">City or ZIP code</label>
        <span class="field-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="2.2" stroke="currentColor" stroke-width="1.8"/></svg>
        </span>
        <input id="dir-location" name="location" value="@query.Location" placeholder="City or ZIP code" autocomplete="postal-code" data-testid="shops-location" />
        <button type="button" class="dir-loc-clear" id="dir-loc-clear" hidden="@(!hasLocation)" aria-label="Clear location" data-testid="shops-location-clear">×</button>
    </div>
    <button class="ntca-primary-action" type="submit" data-testid="shops-search-submit">Search</button>
    <input type="hidden" name="lat" id="dir-lat" value="@(query.Lat?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
    <input type="hidden" name="lng" id="dir-lng" value="@(query.Lng?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
    <input type="hidden" name="specialty" value="@query.Specialty" />
    <input type="hidden" name="sort" value="@sort" />
</form>
