@model Ntca.Core.Shop
@{
    var miles = Ntca.Web.Services.ShopCopy.MilesFrom(Model, ViewBag.OriginLat as double?, ViewBag.OriginLng as double?);
    var milesLabel = Ntca.Web.Services.ShopCopy.FormatMiles(miles);
    var spec = Ntca.Web.Services.ShopCopy.SpecialtyLabel(Model.PrimarySpecialty);
    var blurb = Ntca.Web.Services.ShopCopy.OneLine(Model);
    var loc = Ntca.Web.Services.ShopCopy.Loc(Model);
    var claimed = Ntca.Web.Services.ShopCopy.IsClaimed(Model);
    var open = Ntca.Web.Services.ShopCopy.OpeningStatus(Model.Hours, Model.StateCode);
    var googleMap = ViewBag.Google as IReadOnlyDictionary<long, Ntca.Web.Services.GooglePlaceView>;
    var google = googleMap != null && googleMap.TryGetValue(Model.ShopId, out var gv) ? gv : null;
    var mediaMap = ViewBag.OwnerMedia as IReadOnlyDictionary<long, Ntca.Web.Services.ShopPublicMedia>;
    var media = mediaMap != null && mediaMap.TryGetValue(Model.ShopId, out var om) ? om : null;
    var ownerCover = media?.CoverCardUrl;
    var logo = media?.LogoUrl;
    var photo = google?.Photos.FirstOrDefault();
    var featured = Ntca.Web.Services.ShopCopy.IsFeatured(Model);
}
<article class="shop-card" data-shop="@Model.ShopId" data-name="@Model.Name" data-loc="@loc" data-where="@Model.City, @Model.StateCode" data-testid="shop-card-@Model.Slug">
    <div class="shop-card-media">
        @if (!string.IsNullOrEmpty(ownerCover))
        {
            <img src="@ownerCover" alt="" width="640" height="360" loading="lazy" decoding="async" data-testid="shop-cover-@Model.Slug" />
        }
        else if (photo is not null)
        {
            <img src="/media/gplace/@Model.ShopId/@photo.Slot" alt="" width="640" height="360" loading="lazy" decoding="async" />
        }
        else
        {
            <div class="shop-card-ph" aria-hidden="true" data-testid="shop-placeholder-@Model.Slug">NTCA<small>Photo coming soon</small></div>
        }
        @if (!string.IsNullOrEmpty(logo))
        {
            <img class="shop-card-logo" src="@logo" alt="@Model.Name logo" width="48" height="48" data-testid="shop-logo-@Model.Slug" />
        }
        @if (featured)
        {
            <span class="ribbon feat" data-testid="shop-featured-@Model.Slug">Featured</span>
        }
        else if (Model.IsDestinationShop)
        {
            <span class="ribbon dest">Destination</span>
        }
        <button type="button" class="save-btn" data-save-shop aria-pressed="false" aria-label="Save @Model.Name">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 5.6-7 10-7 10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </button>
    </div>
    <div class="shop-card-body">
        <h3><a href="@loc">@Model.Name</a></h3>
        @if (spec.Length > 0)
        {
            <p class="shop-card-specs">@spec</p>
        }
        <p class="shop-card-where">
            <svg class="pin" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
            @Model.City, @Model.StateCode
            @if (milesLabel.Length > 0)
            {
                <span>· @milesLabel</span>
            }
        </p>
        @if (open is not null)
        {
            <p class="shop-card-status">@open.Label</p>
        }
        else if (google?.Cache.OpenNow is true)
        {
            <p class="shop-card-status">Open now</p>
        }
        @if (google?.Cache.Rating is { } rating)
        {
            <p class="gplace-rating">
                <span aria-hidden="true">★</span> @rating.ToString("0.0")
                @if (google.Cache.UserRatingCount is { } n)
                {
                    if (!string.IsNullOrEmpty(google.Cache.GoogleMapsUri))
                    {
                        <a href="@google.Cache.GoogleMapsUri" rel="noopener nofollow" target="_blank">(@n Google reviews)</a>
                    }
                    else
                    {
                        <span>(@n Google reviews)</span>
                    }
                }
            </p>
        }
        @if (featured && Model.IsDestinationShop)
        {
            <p class="meta" data-testid="shop-destination-note-@Model.Slug">Destination — imported, review needed</p>
        }
        @if (claimed)
        {
            <span class="owner-badge">Owner claimed</span>
        }
        <p class="shop-card-blurb">@blurb</p>
        @{
            var cardSocials = Ntca.Web.Services.ShopSocialLinks.Resolve(Model, 4);
            ViewBag.SocialCompact = true;
            ViewBag.SocialTake = 4;
        }
        @if (cardSocials.Count > 0)
        {
            <div class="shop-card-social">
                @await Html.PartialAsync("~/Views/Shared/_SocialIcons.cshtml", cardSocials)
            </div>
        }
        <p class="shop-card-actions"><a class="btn ghost" href="/t/view?shop=@Model.ShopId">View shop</a></p>
    </div>
</article>
