@using Ntca.Web.Services
@{
    var step = (string)ViewBag.Step;
    var answers = (Dictionary<string, string>)ViewBag.Answers;
    var back = ViewBag.Back as string;
    var progress = (int)ViewBag.Progress;
    var roles = ViewBag.Roles as IReadOnlyList<string> ?? [];
    var token = ViewBag.Token as Guid?;
    var qs = token is Guid t ? "?token=" + t : "";
    ViewData["Title"] = "Get to know you";
    string Val(string k) => answers.GetValueOrDefault(k) ?? "";
    string Action(string s) => "/onboarding/" + s + qs;
    string Question() => step switch
    {
        "who" => "Who are you?",
        "zip" => "What’s your ZIP code?",
        "interests" => "What do you collect?",
        "experience" => "How long have you been in the hobby?",
        "travel" => "How far will you travel to a show?",
        "shop_find" => "Find your shop",
        "shop_tier" => "Choose a listing tier",
        "show_find" => "Find your show",
        "mfr_find" => "Find your company",
        "done" => "Thanks — you’re set",
        _ => "Get to know you"
    };
}
<div class="funnel">
<p class="kicker">Get to know you</p>
<div class="funnel-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress" aria-label="Onboarding progress">
    <span style="width:@progress%"></span>
</div>
@if (back is not null && step != "done")
{
    <p class="funnel-back"><a class="btn ghost" href="/onboarding/@back@qs">← Back</a></p>
}
<h1>@Question()</h1>
<p class="meta">Optional. Multi-select who you are, then we’ll walk each role. Skip anytime — you can resume from <a href="/account@qs">your account</a>.</p>
@if (ViewBag.Error is string err)
{
    <p class="card" role="alert">@err</p>
}

@if (step == "who")
{
    <p class="lede">Pick every hat you wear. A collector who owns a shop can choose both.</p>
    <form method="post" action="@Action("who")" class="funnel-options">
        @Html.AntiForgeryToken()
        <fieldset class="funnel-options">
            <legend class="visually-hidden">Who are you?</legend>
            @foreach (var r in FunnelFlow.Roles)
            {
                <label class="funnel-card">
                    <input type="checkbox" name="roles" value="@r.Role" @(roles.Contains(r.Role) ? "checked" : null) />
                    <svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@FunnelFlow.Icon(r.Role)" /></svg>
                    <span class="funnel-card-copy">
                        <strong>@r.Title</strong>
                        <span>@r.Blurb</span>
                    </span>
                </label>
            }
        </fieldset>
        <button class="btn" type="submit">Continue</button>
    </form>
}
else if (step == "zip")
{
    <form method="post" action="@Action("zip")" class="funnel-form">
        @Html.AntiForgeryToken()
        <p><label for="zip">ZIP code<br /><input id="zip" name="zip" value="@Val("zip")" inputmode="numeric" autocomplete="postal-code" maxlength="10" required /></label></p>
        <p><label for="city">City (optional)<br /><input id="city" name="city" value="@Val("city")" autocomplete="address-level2" /></label></p>
        <p><label for="state">State<br /><input id="state" name="state" value="@Val("state")" maxlength="2" placeholder="NC" autocomplete="address-level1" /></label></p>
        <button class="btn" type="submit">Continue</button>
    </form>
}
else if (step == "interests")
{
    <form method="post" action="@Action("interests")" class="funnel-options">
        @Html.AntiForgeryToken()
        @{ var picked = Val("interests").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); }
        <fieldset class="funnel-options">
            <legend class="visually-hidden">What do you collect?</legend>
            @foreach (var i in FunnelFlow.CollectInterests)
            {
                <label class="funnel-card">
                    <input type="checkbox" name="interests" value="@i.Key" @(picked.Contains(i.Key) ? "checked" : null) />
                    <svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@FunnelFlow.Icon(i.Key)" /></svg>
                    <span class="funnel-card-copy"><strong>@i.Label</strong></span>
                </label>
            }
        </fieldset>
        <button class="btn" type="submit">Continue</button>
    </form>
}
else if (step == "experience")
{
    <form method="post" action="@Action("experience")" class="funnel-options">
        @Html.AntiForgeryToken()
        <fieldset class="funnel-options">
            <legend class="visually-hidden">How long have you been in the hobby?</legend>
            @foreach (var e in new[] { ("new", "Brand new", "Just getting started."), ("year", "About a year", "I know the basics."), ("vet", "Several years", "I collect regularly.") })
            {
                <label class="funnel-card">
                    <input type="radio" name="experience" value="@e.Item1" required @(Val("experience") == e.Item1 ? "checked" : null) />
                    <svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@FunnelFlow.Icon(e.Item1)" /></svg>
                    <span class="funnel-card-copy"><strong>@e.Item2</strong><span>@e.Item3</span></span>
                </label>
            }
        </fieldset>
        <button class="btn" type="submit">Continue</button>
    </form>
}
else if (step == "travel")
{
    <form method="post" action="@Action("travel")" class="funnel-options">
        @Html.AntiForgeryToken()
        <fieldset class="funnel-options">
            <legend class="visually-hidden">How far will you travel to a show?</legend>
            @foreach (var t in new[] { ("15", "15 miles", "Stay local."), ("30", "30 miles", "A short drive."), ("60", "60 miles", "Worth the trip."), ("120", "2 hours / 120 miles", "I’ll go farther for a good show.") })
            {
                <label class="funnel-card">
                    <input type="radio" name="travel" value="@t.Item1" required @(Val("travel") == t.Item1 ? "checked" : null) />
                    <svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@FunnelFlow.Icon(t.Item1)" /></svg>
                    <span class="funnel-card-copy"><strong>@t.Item2</strong><span>@t.Item3</span></span>
                </label>
            }
        </fieldset>
        <button class="btn" type="submit">Continue</button>
    </form>
}
else if (step == "shop_find")
{
    <p class="lede">Type at least two letters. We search name, city, state, and ZIP — we never dump the full directory. Selecting a shop files a pending claim for staff. Adding a missing shop files a pending listing, not a live row.</p>
    <form method="post" action="@Action("shop_find")" class="tools" data-typeahead="shops" data-id-field="shopId">
        @Html.AntiForgeryToken()
        <p><label for="shopQ" class="visually-hidden">Shop name, city, or ZIP</label>
        <input id="shopQ" name="shopQ" class="typeahead-q" value="@Val("shopQ")" placeholder="Shop name, city, or ZIP" autocomplete="off" /></p>
        <button class="btn ghost" type="submit" name="stay" value="1">Search</button>
    </form>
    <form method="post" action="@Action("shop_find")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="shopId" id="shopId" value="@Val("shopId")" />
        <ul class="typeahead-list" id="shop-hits">
        @if (ViewBag.Hits is IEnumerable<object> hits)
        {
            foreach (var raw in hits)
            {
                <li>
                    <label class="funnel-card">
                        <input type="radio" name="shopId" value="@FunnelFlow.Hit(raw, "id")" @(Val("shopId") == FunnelFlow.Hit(raw, "id") ? "checked" : null) />
                        <svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@FunnelFlow.Icon("shop_owner")" /></svg>
                        <span class="funnel-card-copy"><strong>@FunnelFlow.Hit(raw, "name")</strong><span>@FunnelFlow.Hit(raw, "detail")</span></span>
                    </label>
                </li>
            }
        }
        </ul>
        <button class="btn" type="submit" name="claim" value="1">This is my shop — request claim</button>
        <p class="meta">I don’t see my shop — add it for staff review:</p>
        <p><label for="shopName">Shop name<br /><input id="shopName" name="shopName" value="@Val("shopName")" /></label></p>
        <p><label for="shopCity">City<br /><input id="shopCity" name="shopCity" value="@Val("shopCity")" /></label></p>
        <p><label for="shopState">State<br /><input id="shopState" name="shopState" value="@Val("shopState")" maxlength="2" /></label></p>
        <p><label for="shopZip">ZIP<br /><input id="shopZip" name="shopZip" value="@Val("shopZip")" /></label></p>
        <p class="meta">Optional socials (handle or full URL). Staff review these — they are not live.</p>
        <p><label for="shopWebsite">Website<br /><input id="shopWebsite" name="shopWebsite" value="@Val("shopWebsite")" placeholder="https://" /></label></p>
        <p><label for="shopFacebook">Facebook<br /><input id="shopFacebook" name="shopFacebook" value="@Val("shopFacebook")" /></label></p>
        <p><label for="shopInstagram">Instagram<br /><input id="shopInstagram" name="shopInstagram" value="@Val("shopInstagram")" placeholder="@Html.Raw("@handle")" /></label></p>
        <p><label for="shopTiktok">TikTok<br /><input id="shopTiktok" name="shopTiktok" value="@Val("shopTiktok")" /></label></p>
        <p><label for="shopYoutube">YouTube<br /><input id="shopYoutube" name="shopYoutube" value="@Val("shopYoutube")" /></label></p>
        <p><label for="shopWhatnot">Whatnot<br /><input id="shopWhatnot" name="shopWhatnot" value="@Val("shopWhatnot")" /></label></p>
        <button class="btn ghost" type="submit" name="add" value="1">Add my shop</button>
        <button class="btn ghost" type="submit">Continue without claiming</button>
    </form>
}
else if (step == "shop_tier")
{
    <p class="lede">Free is live now. Featured and Premium prices are TBD — Stripe checkout is not on this branch.</p>
    <form method="post" action="@Action("shop_tier")" class="funnel-options">
        @Html.AntiForgeryToken()
        <fieldset class="funnel-options">
            <legend class="visually-hidden">Listing tier</legend>
            @foreach (var t in new[] { ("FREE", "Free listing", "Unclaimed or claimed directory row."), ("PAID", "Featured Listing", "Paid tier — invoice later."), ("PREMIUM", "Premium Partner", "Paid tier — invoice later.") })
            {
                <label class="funnel-card">
                    <input type="radio" name="tier" value="@t.Item1" required @(Val("tier") == t.Item1 ? "checked" : null) />
                    <svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@FunnelFlow.Icon(t.Item1)" /></svg>
                    <span class="funnel-card-copy"><strong>@t.Item2</strong><span>@t.Item3</span></span>
                </label>
            }
        </fieldset>
        <button class="btn" type="submit">Continue</button>
    </form>
}
else if (step == "show_find")
{
    <p class="lede">Search published shows by name, city, state, or ZIP. Missing shows go to the staff queue — they are not published live.</p>
    <form method="post" action="@Action("show_find")" class="tools" data-typeahead="shows" data-id-field="showId">
        @Html.AntiForgeryToken()
        <p><label for="showQ" class="visually-hidden">Show name or city</label>
        <input id="showQ" name="showQ" class="typeahead-q" value="@Val("showQ")" placeholder="Show name, city, or ZIP" autocomplete="off" /></p>
        <button class="btn ghost" type="submit" name="stay" value="1">Search</button>
    </form>
    <form method="post" action="@Action("show_find")">
        @Html.AntiForgeryToken()
        <ul class="typeahead-list">
        @if (ViewBag.Hits is IEnumerable<object> showHits)
        {
            foreach (var raw in showHits)
            {
                <li>
                    <label class="funnel-card">
                        <input type="radio" name="showId" value="@FunnelFlow.Hit(raw, "id")" @(Val("showId") == FunnelFlow.Hit(raw, "id") ? "checked" : null) />
                        <svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@FunnelFlow.Icon("promoter")" /></svg>
                        <span class="funnel-card-copy"><strong>@FunnelFlow.Hit(raw, "name")</strong><span>@FunnelFlow.Hit(raw, "detail")</span></span>
                    </label>
                </li>
            }
        }
        </ul>
        <button class="btn" type="submit" name="claim" value="1">This is my show</button>
        <p class="meta">I don’t see my show — add it:</p>
        <p><label for="showTitle">Show name<br /><input id="showTitle" name="showTitle" value="@Val("showTitle")" /></label></p>
        <p><label for="showCity">City<br /><input id="showCity" name="showCity" value="@Val("showCity")" /></label></p>
        <p><label for="showState">State<br /><input id="showState" name="showState" value="@Val("showState")" maxlength="2" /></label></p>
        <p><label for="showStarts">Start date<br /><input id="showStarts" name="showStarts" type="date" value="@Val("showStarts")" /></label></p>
        <button class="btn ghost" type="submit" name="add" value="1">Add my show</button>
        <button class="btn ghost" type="submit">Continue</button>
    </form>
}
else if (step == "mfr_find")
{
    <p class="lede">Search manufacturers by name. New names go to staff as a pending add, not a live page.</p>
    <form method="post" action="@Action("mfr_find")" class="tools" data-typeahead="manufacturers" data-id-field="mfrId">
        @Html.AntiForgeryToken()
        <p><label for="mfrQ" class="visually-hidden">Manufacturer name</label>
        <input id="mfrQ" name="mfrQ" class="typeahead-q" value="@Val("mfrQ")" placeholder="Manufacturer name" autocomplete="off" /></p>
        <button class="btn ghost" type="submit" name="stay" value="1">Search</button>
    </form>
    <form method="post" action="@Action("mfr_find")">
        @Html.AntiForgeryToken()
        <ul class="typeahead-list">
        @if (ViewBag.Hits is IEnumerable<object> mfrHits)
        {
            foreach (var raw in mfrHits)
            {
                <li>
                    <label class="funnel-card">
                        <input type="radio" name="mfrId" value="@FunnelFlow.Hit(raw, "id")" @(Val("mfrId") == FunnelFlow.Hit(raw, "id") ? "checked" : null) />
                        <svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@FunnelFlow.Icon("manufacturer")" /></svg>
                        <span class="funnel-card-copy"><strong>@FunnelFlow.Hit(raw, "name")</strong><span>@FunnelFlow.Hit(raw, "detail")</span></span>
                    </label>
                </li>
            }
        }
        </ul>
        <button class="btn" type="submit" name="claim" value="1">This is my company</button>
        <p class="meta">I don’t see my company — add it:</p>
        <p><label for="mfrName">Company name<br /><input id="mfrName" name="mfrName" value="@Val("mfrName")" /></label></p>
        <button class="btn ghost" type="submit" name="add" value="1">Add my company</button>
        <button class="btn ghost" type="submit">Continue</button>
    </form>
}
else if (step == "done")
{
    var answer = ViewBag.Answer as AgentAnswer;
    <p class="lede">Thanks. Shop claims and new listings sit in the staff queue until someone reviews them — nothing goes live from this form.</p>
    @if (roles.Contains("parent"))
    {
        <p class="card"><a href="/new-to-trading-cards">New to Trading Cards</a> — glossary and condition guide for beginners.</p>
    }
    @if (answer is not null && answer.Shops.Count > 0)
    {
        <div class="funnel-results">
            <h2>Nearby shops</h2>
            @foreach (var raw in answer.Shops)
            {
                <a class="funnel-card funnel-hit" href="@FunnelFlow.Hit(raw, "url")">
                    <svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="@FunnelFlow.Icon("shop_owner")" /></svg>
                    <span class="funnel-card-copy"><strong>@FunnelFlow.Hit(raw, "Name")</strong><span>@FunnelFlow.Hit(raw, "City"), @FunnelFlow.Hit(raw, "StateCode")</span></span>
                </a>
            }
        </div>
    }
    <p><a class="btn" href="/account@qs">My account</a> <a class="btn ghost" href="/">Home</a></p>
}

@if (step != "done" && step != "who")
{
    <form method="post" action="/onboarding/skip@qs" class="funnel-back">
        @Html.AntiForgeryToken()
        <button class="btn ghost" type="submit">Skip for now</button>
    </form>
}
else if (step == "who")
{
    <form method="post" action="/onboarding/skip@qs" class="funnel-back">
        @Html.AntiForgeryToken()
        <button class="btn ghost" type="submit">Skip for now</button>
    </form>
}
</div>
@section Scripts {
<script>
(function () {
  var boxes = document.querySelectorAll("[data-typeahead]");
  boxes.forEach(function (box) {
    var input = box.querySelector(".typeahead-q");
    var kind = box.getAttribute("data-typeahead");
    var list = box.parentElement.querySelector(".typeahead-list");
    if (!input || !list) return;
    var timer = null;
    input.addEventListener("input", function () {
      clearTimeout(timer);
      var q = input.value.trim();
      if (q.length < 2) { list.innerHTML = ""; return; }
      timer = setTimeout(function () {
        fetch("/api/v1/search/" + kind + "?q=" + encodeURIComponent(q) + "&page=1")
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var items = (data && data.items) || [];
            list.innerHTML = items.map(function (it) {
              return '<li><label class="funnel-card"><input type="radio" name="' + (kind === "shops" ? "shopId" : kind === "shows" ? "showId" : "mfrId") + '" value="' + it.id + '" /><svg class="funnel-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10l8-5 8 5 M5 10v10h14V10" /></svg><span class="funnel-card-copy"><strong>' + escapeHtml(it.name) + '</strong><span>' + escapeHtml(it.detail || "") + '</span></span></label></li>';
            }).join("");
          }).catch(function () {});
      }, 300);
    });
  });
  function escapeHtml(s) {
    return String(s || "").replace(/[&<>"']/g, function (c) {
      return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c];
    });
  }
})();
</script>
}
