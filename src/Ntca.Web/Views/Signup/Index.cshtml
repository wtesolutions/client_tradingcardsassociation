@model Ntca.Web.Controllers.SignupForm
@{
    ViewData["Title"] = "Preview signup";
}
<p class="kicker">Preview</p>
<h1>Get the announcement first</h1>
<p class="lede">Native NTCA signup — stored in <code>crm.Signup</code>. Cloudflare Turnstile is optional and off in Development.</p>
@if (ViewBag.Already as bool? == true)
{
    <p class="card">That email is already on the Preview list.</p>
}
<form method="post">
    @Html.AntiForgeryToken()
    <p><label>Email<br /><input asp-for="Email" type="email" required /></label></p>
    <p><label>First name<br /><input asp-for="FirstName" /></label></p>
    <p><label>Last name<br /><input asp-for="LastName" /></label></p>
    <p><label>I am a<br />
        <select asp-for="HobbySegment">
            <option value="">Choose…</option>
            <option>Collector</option>
            <option>Local Card Shop</option>
            <option>Dealer</option>
            <option>Breaker</option>
            <option>Content Creator</option>
            <option>Grading / Authentication</option>
            <option>Manufacturer</option>
            <option>Other</option>
        </select>
    </label></p>
    <p><label>Note<br /><textarea asp-for="Message" rows="3"></textarea></label></p>
    <button class="btn" type="submit">Join Preview</button>
</form>
