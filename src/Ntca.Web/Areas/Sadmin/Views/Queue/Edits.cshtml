@model List<Ntca.Core.ShopEditRequest>
@{
    ViewData["Title"] = "Owner edits";
}
<h1>Owner edit queue</h1>
@if (!Model.Any()) { <p class="meta">No owner edits waiting.</p> }
@foreach (var s in Model)
{
    <div class="card" style="margin-bottom:12px">
        <h3>@(s.Shop?.Name ?? ("Shop " + s.ShopId))</h3>
        <pre style="white-space:pre-wrap">@s.ProposedJson</pre>
        <form method="post" action="/SADMIN/queue/edits/@s.ShopEditRequestId">
            @Html.AntiForgeryToken()
            <input name="reason" placeholder="Note" />
            <button class="btn" name="decision" value="approve">Approve</button>
            <button class="btn ghost" name="decision" value="reject">Reject</button>
        </form>
    </div>
}
