@model List<Ntca.Core.Shop>
@{
    ViewData["Title"] = "Shops";
}
<h1>Shops</h1>
<form class="tools" method="get" action="/SADMIN/shops">
    <input name="q" value="@ViewBag.Q" placeholder="Name or city" />
    <input name="state" value="@ViewBag.State" placeholder="State" maxlength="2" />
    <button class="btn" type="submit">Filter</button>
</form>
<table>
    <tr><th>Name</th><th>City</th><th>Claim</th><th>Listing</th><th>Source</th><th>Imp 7d</th></tr>
    @{
        var imp = (Dictionary<long, int>)ViewBag.Imp7;
    }
    @foreach (var s in Model)
    {
        <tr>
            <td><a href="/SADMIN/shops/@s.ShopId/stats">@s.Name</a></td>
            <td>@s.City, @s.StateCode</td>
            <td>@s.ClaimStatus</td>
            <td>@s.ListingStatus</td>
            <td>@s.SourceSystem @(s.IsDestinationShop ? "· dest" : "")</td>
            <td>@(imp.GetValueOrDefault(s.ShopId))</td>
        </tr>
    }
</table>
