@model Ntca.Web.Areas.Sadmin.Controllers.SadminLoginForm
@{
    ViewData["Title"] = "Staff sign-in";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<h1>Staff sign-in</h1>
<p class="lede">Emailed code. Seeded SUPERADMIN: egarrison@wte.net. In Development the code is written to the console.</p>
<form method="post" action="/SADMIN/login">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <p><label>Email<br /><input asp-for="Email" type="email" required /></label></p>
    @if (ViewBag.Sent as bool? == true)
    {
        <p><label>Code<br /><input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" /></label></p>
    }
    <button class="btn" type="submit">@(ViewBag.Sent as bool? == true ? "Sign in" : "Send code")</button>
</form>
