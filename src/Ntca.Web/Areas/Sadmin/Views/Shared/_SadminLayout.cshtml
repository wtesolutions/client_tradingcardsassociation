<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "SADMIN") · NTCA staff</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="sadmin">
    <div class="top">
        <strong>NTCA Staff</strong>
        <nav>
            <a href="/SADMIN/dashboard">Dashboard</a> ·
            <a href="/SADMIN/queue/events">Event queue</a> ·
            <a href="/SADMIN/queue/edits">Edit queue</a> ·
            <a href="/SADMIN/queue/onboarding">Onboarding</a> ·
            <a href="/SADMIN/queue/drafts">Drafts</a> ·
            <a href="/SADMIN/shops">Shops</a> ·
            <a href="/SADMIN/agents">AI Visitors</a> ·
            <a href="/SADMIN/funnel">Funnel</a> ·
            <a href="/SADMIN/google">Google</a> ·
            <a href="/SADMIN/social">Social catalog</a> ·
            <a href="/SADMIN/manufacturers">Manufacturers</a> ·
            <a href="/">Public site</a>
        </nav>
        <form method="post" action="/SADMIN/logout" style="margin:0">@Html.AntiForgeryToken()<button class="btn ghost" type="submit">Sign out</button></form>
    </div>
    <main>
        @RenderBody()
    </main>
</body>
</html>
