@model Ntca.Web.Areas.Owner.Controllers.OwnerLoginForm
@{
    ViewData["Title"] = "Shop owner sign-in";
}
<h1>Shop owner sign-in</h1>
<p class="lede">Passwordless. We email a 6-digit code.</p>
<form method="post" data-testid="owner-login-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    @if (ViewBag.MailHint is string hint)
    {
        <p class="card" role="status">@hint</p>
    }
    @if (ViewBag.DevBypass as bool? == true)
    {
        <p class="meta">Development bypass is on: enter <strong>888888</strong> after requesting a code.</p>
    }
    <p><label>Email<br /><input asp-for="Email" type="email" required data-testid="owner-login-email" /></label></p>
    @if (ViewBag.Sent as bool? == true)
    {
        <p><label>Code<br /><input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" data-testid="owner-login-code" /></label></p>
    }
    <button class="btn" type="submit" data-testid="owner-login-submit">@(ViewBag.Sent as bool? == true ? "Sign in" : "Send code")</button>
</form>
