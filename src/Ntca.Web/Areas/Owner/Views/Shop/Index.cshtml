@model Ntca.Core.Shop
@{
    ViewData["Title"] = "Edit your shop";
}
<h1>Edit @Model.Name</h1>
@if (TempData["Saved"] is string msg) { <p class="card">@msg</p> }
@{
    var s7 = (Ntca.Web.Services.ShopStatTotals)ViewBag.Stats7;
    var s30 = (Ntca.Web.Services.ShopStatTotals)ViewBag.Stats30;
    var s90 = (Ntca.Web.Services.ShopStatTotals)ViewBag.Stats90;
    var daily = (List<Ntca.Web.Services.ShopDayPoint>)ViewBag.Daily;
    var max = daily.Count == 0 ? 1 : Math.Max(1, daily.Max(d => d.Impressions + d.Views));
}
<section class="card">
    <h2>Listing activity</h2>
    <p class="meta">Every public appearance counts — Free and unclaimed listings included. Bots are filtered.</p>
    <div class="hero-stats">
        <div><strong>@s7.Impressions</strong><span class="meta">impressions · 7d</span></div>
        <div><strong>@s7.Views</strong><span class="meta">detail views · 7d</span></div>
        <div><strong>@s7.Clicks</strong><span class="meta">clicks · 7d</span></div>
        <div><strong>@s30.Impressions</strong><span class="meta">impressions · 30d</span></div>
        <div><strong>@s30.Views</strong><span class="meta">views · 30d</span></div>
        <div><strong>@s90.Impressions</strong><span class="meta">impressions · 90d</span></div>
    </div>
    <p class="meta">Clicks: website @s30.WebsiteClicks · phone @s30.PhoneClicks · directions @s30.DirectionsClicks · social @s30.SocialClicks (30d)</p>
    <div class="bars" title="Daily impressions + views, last 30 days">
        @foreach (var d in daily)
        {
            var h = (int)Math.Round(100.0 * (d.Impressions + d.Views) / max);
            <div class="bar" style="height:@(Math.Max(h, 2))%" title="@d.Date.ToString("MMM d"): @d.Impressions impressions, @d.Views views, @d.Clicks clicks"></div>
        }
    </div>
</section>
<p class="lede">Changes go to the SADMIN owner-edit queue. They are not live until staff approve them.</p>
<form method="post">
    @Html.AntiForgeryToken()
    <p><label>Name<br /><input name="Name" value="@Model.Name" /></label></p>
    <p><label>Address<br /><input name="AddressLine1" value="@Model.AddressLine1" /></label></p>
    <p><label>City<br /><input name="City" value="@Model.City" /></label></p>
    <p><label>State<br /><input name="StateCode" value="@Model.StateCode" maxlength="2" /></label></p>
    <p><label>Postal<br /><input name="PostalCode" value="@Model.PostalCode" /></label></p>
    <p><label>Phone<br /><input name="Phone" value="@Model.Phone" /></label></p>
    <p><label>Website<br /><input name="WebsiteUrl" value="@Model.WebsiteUrl" /></label></p>
    <p><label>Public email<br /><input name="PublicEmail" value="@Model.PublicEmail" /></label></p>
    <p><label>Description<br /><textarea name="Description" rows="4">@Model.Description</textarea></label></p>
    <button class="btn" type="submit">Submit for review</button>
</form>
<section class="card">
    <h2>Social links</h2>
    <p class="meta">These go live immediately — they are not queued. Accept an @Html.Raw("@handle") or a full URL. Whatnot has no Font Awesome icon; the public site shows a small W badge.</p>
    @if (TempData["SocialError"] is string socialErr)
    {
        <p class="card" role="alert">@socialErr</p>
    }
    @{
        var socials = ViewBag.Socials as IReadOnlyList<Ntca.Core.ShopSocial> ?? [];
        var platforms = ViewBag.Platforms as IReadOnlyList<Ntca.Core.SocialPlatform> ?? [];
    }
    @if (socials.Count == 0)
    {
        <p class="meta">No social links yet.</p>
    }
    else
    {
        <ul class="social-edit">
        @foreach (var row in socials)
        {
            <li>
                <strong>@(row.Platform?.Label ?? row.PlatformCode)</strong>
                <span class="meta">@row.Url</span>
                <form method="post" action="/owner/social/@row.ShopSocialId/move" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button class="btn ghost" name="delta" value="-1" type="submit">Up</button>
                    <button class="btn ghost" name="delta" value="1" type="submit">Down</button>
                </form>
                <form method="post" action="/owner/social/@row.ShopSocialId/remove" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button class="btn ghost" type="submit">Remove</button>
                </form>
            </li>
        }
        </ul>
    }
    <form method="post" action="/owner/social">
        @Html.AntiForgeryToken()
        <p>
            <label>Platform<br />
                <select name="platformCode">
                @foreach (var p in platforms)
                {
                    <option value="@p.Code">@p.Label</option>
                }
                </select>
            </label>
        </p>
        <p><label>Handle or URL<br /><input name="raw" placeholder="@Html.Raw("@shopname or https://…")" /></label></p>
        <button class="btn" type="submit">Add or update link</button>
    </form>
</section>
<form method="post" action="/owner/logout">@Html.AntiForgeryToken()<button class="btn ghost" type="submit">Sign out</button></form>
